# Use a NEW database dedicated to this prototype. Never use the backend database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polinetwork_identity
BETTER_AUTH_URL=https://auth.polinetwork.org
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# For local development, override BETTER_AUTH_URL with http://localhost:3000 in .env.local.
# Enable a provider by setting all its credentials. Leave unused providers commented.
# The PN app also reads Soci membership: grant Microsoft Graph application
# GroupMember.Read.All and admin consent on this app registration.
# PN_ENTRA_CLIENT_ID=
# PN_ENTRA_CLIENT_SECRET=
# PN_ENTRA_TENANT_ID=
# Microsoft Entra security group used by the backend for PN members (the Soci group).
PN_ENTRA_MEMBER_GROUP_ID=1c68dbb8-4ac3-4569-a886-283b5a825cbd
# Membership is checked with Microsoft Graph again after this interval.
PN_ENTRA_MEMBER_REFRESH_HOURS=24

# Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Credentials from BotFather > Bot Settings > Web Login.
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=

# Microsoft Graph application used to send Polimi verification codes.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
AZURE_EMAIL_SENDER=noreply@polinetwork.org
STUDENT_VERIFICATION_TTL_DAYS=365

# Who may manage OIDC clients at /applications. By default every signed-in PN Entra
# account can. Set this to a stricter Microsoft Entra group (object ID) to limit it
# to that group's direct members; the PN_ENTRA app checks it through Graph.
# PN_ENTRA_OIDC_ADMIN_GROUP_ID=
# Comma-separated local user IDs that may always manage OIDC clients (break-glass).
IDP_ADMIN_USER_IDS=
