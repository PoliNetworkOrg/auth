# Use a NEW database dedicated to this prototype. Never use the backend database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polinetwork_identity
BETTER_AUTH_URL=https://auth.polinetwork.org
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# For local development, override BETTER_AUTH_URL with http://localhost:3000 in .env.local.
# Enable a provider by setting all its credentials. Leave unused providers commented.
# PN_ENTRA_CLIENT_ID=
# PN_ENTRA_CLIENT_SECRET=
# PN_ENTRA_TENANT_ID=
# Optional app role in the signed Microsoft roles claim. No role configured = no socio state.
# PN_ENTRA_REQUIRED_ROLE=socio

# Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Credentials from BotFather > Bot Settings > Web Login.
# TELEGRAM_CLIENT_ID=
# TELEGRAM_CLIENT_SECRET=

# Microsoft Graph application used to send Polimi verification codes.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
AZURE_EMAIL_SENDER=noreply@polinetwork.org
STUDENT_VERIFICATION_TTL_DAYS=365

# Comma-separated local user IDs allowed to manage OIDC clients. Empty denies all.
IDP_ADMIN_USER_IDS=
